<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
    <id>$APP_ID</id>
    <metadata_license>MIT</metadata_license>
    <project_license>GPL-3.0-or-later</project_license>

    <name>$APP_NAME</name>
    <summary>Native workspace for coding agents and Git worktrees</summary>
    <developer id="dev.zorca">
        <name translate="no">ZOrca contributors</name>
    </developer>
    <description>
        <p>
            ZOrca brings projects, Git worktrees, coding-agent terminals, files,
            and review tools into one native workspace.
        </p>
        <ul>
            <li>Run multiple coding agents in isolated Git worktrees.</li>
            <li>Work with local and SSH-connected projects.</li>
            <li>Review diffs, stage files, commit, and browse history.</li>
            <li>Use Zed's editor foundation, extensions, and optional GitHub Copilot support.</li>
        </ul>
    </description>

    <launchable type="desktop-id">$APP_ID.desktop</launchable>

    <branding>
        <color type="primary" scheme_preference="light">$BRANDING_LIGHT</color>
        <color type="primary" scheme_preference="dark">$BRANDING_DARK</color>
    </branding>

    <content_rating type="oars-1.1" />

    <url type="homepage">https://zorca.net</url>
    <url type="bugtracker">https://github.com/ifokeev/zorca/issues</url>
    <url type="vcs-browser">https://github.com/ifokeev/zorca</url>
    <url type="contribute">https://github.com/ifokeev/zorca/blob/main/CONTRIBUTING.md</url>

    <supports>
        <internet>offline-only</internet>
    </supports>
    <recommends>
        <control>pointing</control>
        <control>keyboard</control>
        <display_length compare="ge">768</display_length>
    </recommends>

    <releases>
        @release_info@
        <release version="0.0.0" date="1970-01-01">
            <description>
                <p>Development build</p>
            </description>
        </release>
    </releases>
</component>
